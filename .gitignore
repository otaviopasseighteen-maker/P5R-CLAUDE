# Persona 5 Royal Fan Site - .gitignore

# Dependencies (se usar npm/yarn/pnpm)
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
*.min.css
*.min.js

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS
Desktop.ini
ehthumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/
.playwright/
cypress/videos/
cypress/screenshots/

# Environment
.env
.env.local
.env.*.local

# Cache
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
.turbo/

# Misc
*.zip
*.tar.gz
*.rar
*.bak
*.tmp
*.temp

# Service Worker (opcional - se não quiser versionar)
# sw.js

# Assets grandes (se usar git-lfs)
# assets/images/*.png
# assets/images/*.jpg
# assets/images/*.webp
# assets/fonts/*.woff2

# Local development
.local/
*.local